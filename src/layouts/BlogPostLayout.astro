---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, tags, image, heroImage, imageAlt, affiliate } = post.data;
const displayHero = heroImage ?? image;
const canonicalURL = Astro.url.href;
const pinURL = image
  ? `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(canonicalURL)}&media=${encodeURIComponent(image)}&description=${encodeURIComponent(description)}`
  : null;

const formattedPub = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const formattedUpd = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 250);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  pubDate={pubDate}
  author={author}
>
  <Fragment slot="head">
    <!-- Article-specific Open Graph -->
    <meta property="article:section" content={category} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": image ? (image.startsWith('http') ? image : `https://avinovo.com${image}`) : undefined,
      "datePublished": pubDate.toISOString(),
      "dateModified": (updatedDate ?? pubDate).toISOString(),
      "author": { "@type": "Person", "name": author },
      "publisher": {
        "@type": "Organization",
        "name": "Avinovo",
        "logo": { "@type": "ImageObject", "url": "https://avinovo.com/logo-2x.png" }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
      "articleSection": category,
      "keywords": tags.join(", ")
    })} />
  </Fragment>
  <article class="post-article">
    <!-- Hero image -->
    {displayHero && (
      <div class="post-hero-image">
        <img
          src={displayHero}
          alt={imageAlt ?? title}
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-pin-description={description}
          data-pin-url={canonicalURL}
        />
        {pinURL && (
          <a href={pinURL} class="pin-save-btn" target="_blank" rel="noopener" aria-label="Save to Pinterest">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
            Save
          </a>
        )}
      </div>
    )}

    <div class="container">
      <div class="post-inner">
        <!-- Header -->
        <header class="post-header">
          <div class="post-meta">
            <a href={`/blog?category=${encodeURIComponent(category)}`} class="post-category">{category}</a>
            <span class="post-dot" aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formattedPub}</time>
            <span class="post-dot" aria-hidden="true">·</span>
            <span class="post-reading-time">{readingTime} min read</span>
            {updatedDate && (
              <span class="post-updated"> · Updated {formattedUpd}</span>
            )}
          </div>
          <h1 class="post-title">{title}</h1>
          <p class="post-description">{description}</p>
          <div class="post-byline">By {author}</div>
        </header>

        <!-- Affiliate disclosure -->
        {affiliate && (
          <aside class="affiliate-notice">
            This post contains affiliate links. If you buy through them, I may earn a small commission at no extra cost to you. I only recommend things I genuinely use.
          </aside>
        )}

        <!-- Content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Post footer -->
        <footer class="post-footer">
          <div class="post-footer-row">
            <a href="/blog" class="back-link">← Back to journal</a>
            {pinURL && (
              <a href={pinURL} class="pinterest-follow" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
                </svg>
                Save on Pinterest
              </a>
            )}
          </div>
          <p class="pinterest-cta">
            Follow <a href="https://pinterest.com/avinovo_studio" target="_blank" rel="noopener">@avinovo_studio</a> for more interior design ideas.
          </p>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-alt);
    position: relative;
  }
  .post-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }

  .pin-save-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #E60023;
    color: white;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.5rem 0.75rem;
    opacity: 0;
    transition: opacity 0.15s;
    min-height: 36px;
  }
  .post-hero-image:hover .pin-save-btn { opacity: 1; }

  .post-inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-block: var(--space-xl);
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .post-category {
    color: var(--color-accent);
    font-weight: 500;
  }
  .post-category:hover { text-decoration: underline; }

  .post-dot { color: var(--color-border); }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-family: var(--font-serif);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  .post-byline {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .affiliate-notice {
    background: var(--color-bg-alt);
    border-left: 2px solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .post-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .post-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.15s;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .back-link:hover { color: var(--color-accent); }

  .pinterest-follow {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #E60023;
    letter-spacing: 0.02em;
    min-height: 44px;
  }
  .pinterest-follow:hover { opacity: 0.8; }

  .pinterest-cta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    font-style: italic;
    font-family: var(--font-serif);
  }
  .pinterest-cta a {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
