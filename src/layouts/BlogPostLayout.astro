---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, image, imageAlt, affiliate } = post.data;

const formattedPub = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const formattedUpd = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  pubDate={pubDate}
  author={author}
>
  <article class="post-article">
    <!-- Hero image -->
    {image && (
      <div class="post-hero-image">
        <img src={image} alt={imageAlt ?? title} width="1200" height="630" loading="eager" decoding="async" />
      </div>
    )}

    <div class="container">
      <div class="post-inner">
        <!-- Header -->
        <header class="post-header">
          <div class="post-meta">
            <a href={`/blog?category=${encodeURIComponent(category)}`} class="post-category">{category}</a>
            <span class="post-dot" aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formattedPub}</time>
            {updatedDate && (
              <span class="post-updated"> · Updated {formattedUpd}</span>
            )}
          </div>
          <h1 class="post-title">{title}</h1>
          <p class="post-description">{description}</p>
          <div class="post-byline">By {author}</div>
        </header>

        <!-- Affiliate disclosure -->
        {affiliate && (
          <aside class="affiliate-notice">
            This post contains affiliate links. If you buy through them, I may earn a small commission at no extra cost to you. I only recommend things I genuinely use.
          </aside>
        )}

        <!-- Content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Post footer -->
        <footer class="post-footer">
          <a href="/blog" class="back-link">← All posts</a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero-image {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .post-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-block: var(--space-xl);
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .post-category {
    color: var(--color-accent);
    font-weight: 500;
  }
  .post-category:hover { text-decoration: underline; }

  .post-dot { color: var(--color-border); }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-family: var(--font-serif);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  .post-byline {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .affiliate-notice {
    background: var(--color-bg-alt);
    border-left: 2px solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .post-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--color-accent); }
</style>
