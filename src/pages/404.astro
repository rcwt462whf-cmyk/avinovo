---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <div class="not-found">
    <div class="container">
      <p class="not-found-num">404</p>
      <h1 class="not-found-title">Page not found</h1>
      <p class="not-found-sub">The page you're looking for has moved or doesn't exist.</p>
      <a href="/" class="not-found-link">← Back home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .not-found-num {
    font-family: var(--font-serif);
    font-size: 6rem;
    font-style: italic;
    color: var(--color-border);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .not-found-title {
    font-size: 1.75rem;
    margin-bottom: var(--space-sm);
  }
  .not-found-sub {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }
  .not-found-link {
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
  }
  .not-found-link:hover { opacity: 0.7; }
</style>
