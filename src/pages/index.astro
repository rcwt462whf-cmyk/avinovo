---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const recentPosts = sortedPosts.slice(0, 4);
---

<BaseLayout
  title="Avinovo"
  description="Interior design inspiration — spaces, objects, and ideas for living beautifully."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">Interior design</p>
      <h1 class="hero-headline">Interior design<br />for the home you love.</h1>
      <p class="hero-sub">A home worth returning to.</p>
    </div>
  </section>

  <!-- Featured posts -->
  {featuredPosts.length > 0 && (
    <section class="featured-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Featured</h2>
          <a href="/blog" class="section-link">View all →</a>
        </div>
        <div class="posts-grid">
          {featuredPosts.map((post, i) => (
            <PostCard post={post} size={i === 0 ? 'large' : 'default'} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Recent posts -->
  <section class="recent-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Latest</h2>
        <a href="/blog" class="section-link">View all →</a>
      </div>
      <div class="recent-list">
        {recentPosts.map(post => (
          <article class="recent-item">
            {post.data.image && (
              <a href={`/blog/${post.slug}`} class="recent-thumb" aria-hidden="true" tabindex="-1">
                <img
                  src={`${post.data.image.split('?')[0]}?w=120&q=70&auto=format`}
                  alt=""
                  width="60"
                  height="75"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="recent-body">
              <a href={`/blog/${post.slug}`} class="recent-title">{post.data.title}</a>
              <div class="recent-meta">
                <span class="recent-category">{post.data.category}</span>
                <time datetime={post.data.pubDate.toISOString()} class="recent-date">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-xl) var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-style: italic;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    margin: 0;
  }

  /* Sections */
  .featured-section {
    padding-block: var(--space-md) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .recent-section {
    padding-block: var(--space-xl);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .section-title {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-weight: 400;
  }

  .section-link {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }
  .section-link:hover { color: var(--color-accent); }

  /* Featured grid */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: 1.4fr 1fr;
    }
    .posts-grid > :first-child {
      grid-row: span 2;
    }
  }

  /* Recent list */
  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    min-height: 44px;
  }
  .recent-item:last-child { border-bottom: none; }

  .recent-thumb {
    flex-shrink: 0;
    width: 60px;
    height: 75px;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .recent-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recent-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }

  .recent-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-accent);
    line-height: 1.3;
    display: block;
  }
  .recent-title:hover { text-decoration: underline; }

  .recent-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .recent-category {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .recent-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
