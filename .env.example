RESEND_API_KEY=re_your_api_key_here
RESEND_AUDIENCE_ID=your_audience_id_here
# Secret that signs the double opt-in confirmation links — any long random string.
# Generate one with: openssl rand -base64 32
SUBSCRIBE_TOKEN_SECRET=generate_a_long_random_string
# Optional — sender shown on the emails. Must be on the verified domain. Defaults to "Avinovo <hello@avinovo.com>".
RESEND_FROM=Avinovo <hello@avinovo.com>
